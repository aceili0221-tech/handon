#!/bin/bash
# ==============================================================================
# 🏢 企業內部出勤與工時打卡系統 - macOS 雙擊一鍵啟動程式
# ==============================================================================

# 切換至腳本所在之專案根目錄
cd "$(dirname "$0")" || exit 1

echo ""
echo "================================================================="
echo "  🏢 企業內部出勤與工時打卡系統 - 本地啟動程式 (macOS)"
echo "================================================================="
echo ""

# 1. 檢查 Node.js 環境
if ! command -v node &> /dev/null; then
  echo "❌ 錯誤：找不到 Node.js 執行環境！"
  echo "👉 請至官方網站下載並安裝 Node.js (推薦 LTS 版本)："
  echo "   https://nodejs.org/"
  echo ""
  read -p "請按任意鍵退出..."
  exit 1
fi

echo "✅ 已偵測到 Node.js 版本: $(node -v)"
echo "✅ 已偵測到 npm 版本:     $(npm -v)"
echo ""

# 2. 檢查並自動安裝依賴套件 (初次執行或遺失時)
if [ ! -d "node_modules" ]; then
  echo "📦 正在為您安裝專案依賴套件（初次啟動約需 10~20 秒，請稍候）..."
  npm install
  if [ $? -ne 0 ]; then
    echo "❌ 安裝依賴套件失敗，請檢查網路連線。"
    read -p "請按任意鍵退出..."
    exit 1
  fi
  echo "🎉 依賴套件安裝完成！"
  echo ""
fi

# 3. 啟動伺服器並自動開啟預設桌面瀏覽器
echo "🚀 正在啟動本地打卡系統伺服器..."
echo "🌐 系統將自動於您的預設桌面瀏覽器開啟：http://localhost:3000"
echo "💡 (提示：您可以保持此終端視窗開啟，欲關閉系統請按 Ctrl + C)"
echo ""

# 啟動並帶入 --open 參數自動開啟瀏覽器
npm run start:browser
